# MONGODB

def guardar_mongodb():
    if archivo_actual == "" or len(tokens) == 0:
        messagebox.showwarning(
            "Advertencia",
            "Primero debe analizar un archivo."
        )
        return

    conexion = os.getenv("MONGO_URI")

    if conexion is None or conexion == "":
        messagebox.showerror(
            "MongoDB",
            "No se encontró MONGO_URI en el archivo .env."
        )
        return

    cliente = None

    try:
        cliente = MongoClient(conexion)

        base_datos = cliente["analizador_swift"]
        coleccion = base_datos["tabla_simbolos"]

        nombre_archivo = os.path.basename(archivo_actual)

        coleccion.delete_many({
            "archivo": nombre_archivo
        })

        simbolos = []
        identificadores_guardados = set()

        for token in tokens:
            tipo = token["token"].upper()

            if tipo == "IDENTIFICADOR":
                lexema = token["lexema"]

                if lexema not in identificadores_guardados:
                    simbolos.append({
                        "archivo": nombre_archivo,
                        "lexema": lexema,
                        "token": token["token"],
                        "linea": token["linea"],
                        "fecha": datetime.now()
                    })

                    identificadores_guardados.add(lexema)

        if len(simbolos) == 0:
            messagebox.showwarning(
                "MongoDB",
                "No se encontraron identificadores para guardar."
            )
            return

        coleccion.insert_many(simbolos)

        etiqueta_estado.config(
            text="Datos guardados en MongoDB Atlas"
        )

        messagebox.showinfo(
            "MongoDB",
            "La tabla de símbolos fue guardada correctamente."
        )

    except Exception as error:
        messagebox.showerror(
            "Error de MongoDB",
            "No se pudieron guardar los datos.\n" + str(error)
        )

    finally:
        if cliente is not None:
            cliente.close()


