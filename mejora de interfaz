# BUSCAR ANALIZADOR

def buscar_analizador():
    posibles_rutas = [
        "analizador/analizador.exe",
        "analizador/analizador",
        "analizador.exe",
        "analizador"
    ]

    for ruta in posibles_rutas:
        if os.path.exists(ruta):
            return ruta

    return ""


# ANALIZAR ARCHIVO

def analizar_archivo():
    global tokens

    if archivo_actual == "":
        messagebox.showwarning(
            "Advertencia",
            "Primero seleccione un archivo Swift."
        )
        return

    ruta_analizador = buscar_analizador()

    if ruta_analizador == "":
        messagebox.showerror(
            "Error",
            "No se encontró el ejecutable del analizador."
        )
        return

    try:
        with open(archivo_actual, "r", encoding="utf-8") as archivo:
            contenido = archivo.read()

        resultado = subprocess.run(
            [ruta_analizador],
            input=contenido,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace"
        )

        if resultado.returncode != 0:
            messagebox.showerror(
                "Error del analizador",
                resultado.stderr
            )
            return

        tokens = leer_salida_flex(resultado.stdout)

        if len(tokens) == 0:
            messagebox.showwarning(
                "Sin resultados",
                "El analizador no devolvió ningún token."
            )
            return

        mostrar_tokens()
        actualizar_contadores()

        etiqueta_estado.config(
            text="Análisis completado correctamente"
        )

        messagebox.showinfo(
            "Análisis terminado",
            "Se encontraron " + str(len(tokens)) + " tokens."
        )

    except Exception as error:
        messagebox.showerror(
            "Error",
            "No se pudo ejecutar el analizador.\n" + str(error)
        )


# LEER RESULTADOS DE FLEX

def leer_salida_flex(salida):
    lista_tokens = []

    for linea in salida.splitlines():
        partes = linea.split("|", 2)

        if len(partes) == 3:
            numero_linea = partes[0].strip()
            tipo_token = partes[1].strip()
            lexema = partes[2].strip()

            lista_tokens.append({
                "linea": numero_linea,
                "token": tipo_token,
                "lexema": lexema
            })

    return lista_tokens


# TABLA DE TOKENS

def mostrar_tokens():
    limpiar_tabla()

    for token in tokens:
        tabla_tokens.insert(
            "",
            tk.END,
            values=(
                token["linea"],
                token["token"],
                token["lexema"]
            )
        )


def limpiar_tabla():
    for fila in tabla_tokens.get_children():
        tabla_tokens.delete(fila)


# CONTADORES

def contar_tipo(nombre_token):
    cantidad = 0

    for token in tokens:
        tipo = token["token"].upper()

        if tipo == nombre_token:
            cantidad += 1

    return cantidad


def contar_reservadas():
    cantidad = 0

    for token in tokens:
        tipo = token["token"].upper()

        if tipo in PALABRAS_RESERVADAS:
            cantidad += 1

    return cantidad


def contar_operadores():
    cantidad = 0

    for token in tokens:
        tipo = token["token"].upper()

        if tipo in OPERADORES:
            cantidad += 1

    return cantidad


def contar_booleanos():
    cantidad = 0

    for token in tokens:
        tipo = token["token"].upper()

        if tipo in {"BOOLEANO", "TRUE", "FALSE"}:
            cantidad += 1

    return cantidad


def actualizar_contadores():
    valor_tokens.config(
        text=str(len(tokens))
    )

    valor_identificadores.config(
        text=str(contar_tipo("IDENTIFICADOR"))
    )

    valor_enteros.config(
