# REPORTE 1

def generar_reporte_1():
    if archivo_actual == "" or len(tokens) == 0:
        messagebox.showwarning(
            "Advertencia",
            "Primero debe analizar un archivo."
        )
        return

    os.makedirs(CARPETA_REPORTES, exist_ok=True)

    nombre_pdf = os.path.join(
        CARPETA_REPORTES,
        "reporte_1.pdf"
    )

    try:
        with open(archivo_actual, "r", encoding="utf-8") as archivo:
            contenido = archivo.read()

        cantidad_lineas = len(contenido.splitlines())
        cantidad_caracteres = len(contenido)

        conteo_reservadas = {}

        for token in tokens:
            tipo = token["token"].upper()

            if tipo in PALABRAS_RESERVADAS:
                lexema = token["lexema"]

                if lexema in conteo_reservadas:
                    conteo_reservadas[lexema] += 1
                else:
                    conteo_reservadas[lexema] = 1

        reservadas_ordenadas = sorted(
            conteo_reservadas.items(),
            key=lambda dato: dato[1],
            reverse=True
        )

        pdf = canvas.Canvas(nombre_pdf, pagesize=letter)
        ancho, alto = letter

        y = alto - 50

        pdf.setFont("Helvetica-Bold", 16)
        pdf.drawString(
            50,
            y,
            "Reporte 1 - Resumen del análisis"
        )

        y -= 30
        pdf.setFont("Helvetica", 11)

        datos = [
            "Archivo: " + os.path.basename(archivo_actual),
            "Cantidad de líneas: " + str(cantidad_lineas),
            "Cantidad de caracteres: " + str(cantidad_caracteres),
            "Cantidad de tokens: " + str(len(tokens)),
            "Identificadores: " + str(contar_tipo("IDENTIFICADOR")),
            "Enteros: " + str(contar_tipo("ENTERO")),
            "Flotantes: " + str(contar_tipo("FLOTANTE")),
            "Cadenas: " + str(contar_tipo("CADENA")),
            "Booleanos: " + str(contar_booleanos()),
            "Palabras reservadas: " + str(contar_reservadas()),
            "Operadores: " + str(contar_operadores())
        ]

        for dato in datos:
            pdf.drawString(50, y, dato)
            y -= 20

        y -= 10

        pdf.setFont("Helvetica-Bold", 12)
        pdf.drawString(
            50,
            y,
            "Palabras reservadas encontradas"
        )

        y -= 25
        pdf.setFont("Helvetica", 11)

        if len(reservadas_ordenadas) == 0:
            pdf.drawString(
                50,
                y,
                "No se encontraron palabras reservadas."
            )

        for palabra, cantidad in reservadas_ordenadas:
            pdf.drawString(
                70,
                y,
                palabra + ": " + str(cantidad)
            )

            y -= 18

            if y < 50:
                pdf.showPage()
                y = alto - 50
                pdf.setFont("Helvetica", 11)

        pdf.save()

        etiqueta_estado.config(
            text="Reporte 1 generado correctamente"
        )

        messagebox.showinfo(
            "Reporte generado",
            "El Reporte 1 fue creado en la carpeta reportes."
        )

    except Exception as error:
        messagebox.showerror(
            "Error",
            "No se pudo generar el Reporte 1.\n" + str(error)
        )


