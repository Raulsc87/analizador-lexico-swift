    valor_flotantes.config(
        text=str(contar_tipo("FLOTANTE"))
    )

    valor_cadenas.config(
        text=str(contar_tipo("CADENA"))
    )

    valor_booleanos.config(
        text=str(contar_booleanos())
    )

    valor_reservadas.config(
        text=str(contar_reservadas())
    )

    valor_operadores.config(
        text=str(contar_operadores())
    )


